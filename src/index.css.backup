@import "tailwindcss";

/* =========================================================
   SOMS — UNIFIED ENTERPRISE DESIGN SYSTEM
   Sales & Order Management System

   Brand:
   Deep Navy + Teal

   Semantic:
   Emerald = Success
   Amber   = Pending / Warning
   Red     = Danger
   Sky     = Information

   IMPORTANT:
   Departments do NOT get separate themes.
   SOMS remains one visual product everywhere.
   ========================================================= */


/* =========================================================
   DESIGN TOKENS
   ========================================================= */

:root {

  /* -------------------------------------------------------
     SOMS BRAND
     ------------------------------------------------------- */

  --soms-navy-950: #071c26;
  --soms-navy-900: #0b2733;
  --soms-navy-800: #103744;
  --soms-navy-700: #164653;

  --soms-teal-900: #115e59;
  --soms-teal-800: #0f766e;
  --soms-teal-700: #0d9488;
  --soms-teal-600: #14a89c;
  --soms-teal-500: #14b8a6;
  --soms-teal-400: #2dd4bf;
  --soms-teal-300: #5eead4;
  --soms-teal-200: #99f6e4;
  --soms-teal-100: #ccfbf1;
  --soms-teal-50: #f0fdfa;


  /* -------------------------------------------------------
     APPLICATION BACKGROUNDS
     ------------------------------------------------------- */

  --soms-background: #f5f8f8;
  --soms-background-soft: #f8fafc;

  --soms-surface: #ffffff;
  --soms-surface-soft: #fbfdfd;
  --soms-surface-muted: #f8fafc;
  --soms-surface-hover: #f1f5f9;


  /* -------------------------------------------------------
     TEXT
     ------------------------------------------------------- */

  --soms-text-950: #0f172a;
  --soms-text-900: #172033;
  --soms-text-800: #1e293b;
  --soms-text-700: #334155;
  --soms-text-600: #475569;
  --soms-text-500: #64748b;
  --soms-text-400: #94a3b8;
  --soms-text-300: #cbd5e1;


  /* -------------------------------------------------------
     BORDERS
     ------------------------------------------------------- */

  --soms-border: #e2e8f0;
  --soms-border-light: #edf2f7;
  --soms-border-strong: #cbd5e1;


  /* -------------------------------------------------------
     SUCCESS
     ------------------------------------------------------- */

  --soms-success-800: #065f46;
  --soms-success-700: #047857;
  --soms-success-600: #059669;
  --soms-success-100: #d1fae5;
  --soms-success-50: #ecfdf5;


  /* -------------------------------------------------------
     WARNING
     ------------------------------------------------------- */

  --soms-warning-800: #92400e;
  --soms-warning-700: #b45309;
  --soms-warning-600: #d97706;
  --soms-warning-100: #fef3c7;
  --soms-warning-50: #fffbeb;


  /* -------------------------------------------------------
     DANGER
     ------------------------------------------------------- */

  --soms-danger-800: #991b1b;
  --soms-danger-700: #b91c1c;
  --soms-danger-600: #dc2626;
  --soms-danger-100: #fee2e2;
  --soms-danger-50: #fef2f2;


  /* -------------------------------------------------------
     INFORMATION
     ------------------------------------------------------- */

  --soms-info-700: #0369a1;
  --soms-info-600: #0284c7;
  --soms-info-100: #e0f2fe;
  --soms-info-50: #f0f9ff;


  /* -------------------------------------------------------
     FONT
     ------------------------------------------------------- */

  --font-sans:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Helvetica,
    Arial,
    sans-serif;


  /* -------------------------------------------------------
     RADIUS
     ------------------------------------------------------- */

  --radius-xs: 5px;
  --radius-sm: 7px;
  --radius-md: 9px;
  --radius-lg: 12px;
  --radius-xl: 16px;
  --radius-2xl: 20px;


  /* -------------------------------------------------------
     SHADOWS
     ------------------------------------------------------- */

  --shadow-xs:
    0 1px 2px rgba(15, 23, 42, 0.04);

  --shadow-sm:
    0 2px 6px rgba(15, 23, 42, 0.05);

  --shadow-md:
    0 6px 18px rgba(15, 23, 42, 0.07);

  --shadow-lg:
    0 12px 35px rgba(15, 23, 42, 0.10);


  /* -------------------------------------------------------
     MOTION
     ------------------------------------------------------- */

  --transition-fast:
    150ms cubic-bezier(0.4, 0, 0.2, 1);

  --transition:
    220ms cubic-bezier(0.4, 0, 0.2, 1);

  --transition-slow:
    320ms cubic-bezier(0.4, 0, 0.2, 1);


  /* -------------------------------------------------------
     COMPATIBILITY VARIABLES
     ------------------------------------------------------- */

  --brand-950: var(--soms-navy-950);
  --brand-900: var(--soms-navy-900);
  --brand-800: var(--soms-navy-800);
  --brand-700: var(--soms-navy-700);

  --primary-700: var(--soms-teal-800);
  --primary-600: var(--soms-teal-700);
  --primary-500: var(--soms-teal-500);
  --primary-100: var(--soms-teal-100);
  --primary-50: var(--soms-teal-50);

  --success-700: var(--soms-success-700);
  --success-600: var(--soms-success-600);
  --success-100: var(--soms-success-100);
  --success-50: var(--soms-success-50);

  --warning-700: var(--soms-warning-700);
  --warning-600: var(--soms-warning-600);
  --warning-100: var(--soms-warning-100);
  --warning-50: var(--soms-warning-50);

  --danger-700: var(--soms-danger-700);
  --danger-600: var(--soms-danger-600);
  --danger-100: var(--soms-danger-100);
  --danger-50: var(--soms-danger-50);

  --slate-950: #020617;
  --slate-900: var(--soms-text-900);
  --slate-800: var(--soms-text-800);
  --slate-700: var(--soms-text-700);
  --slate-600: var(--soms-text-600);
  --slate-500: var(--soms-text-500);
  --slate-400: var(--soms-text-400);
  --slate-300: var(--soms-text-300);
  --slate-200: #e2e8f0;
  --slate-100: #f1f5f9;
  --slate-50: #f8fafc;

  --background: var(--soms-background);
  --surface: var(--soms-surface);
  --surface-muted: var(--soms-surface-muted);
  --surface-hover: var(--soms-surface-hover);

  --border: var(--soms-border);
  --border-light: var(--soms-border-light);

  color: var(--soms-text-900);
  background: var(--soms-background);

  font-family: var(--font-sans);

  font-synthesis: none;
  text-rendering: optimizeLegibility;

  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}


/* =========================================================
   RESET
   ========================================================= */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  min-height: 100%;
  scroll-behavior: smooth;
}

html,
body,
#root {
  min-width: 320px;
  min-height: 100vh;
}

body {
  margin: 0;
  color: var(--soms-text-900);
  background: var(--soms-background);
  font-size: 14px;
  line-height: 1.5;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  display: block;
  max-width: 100%;
}


/* =========================================================
   TYPOGRAPHY
   ========================================================= */

h1,
h2,
h3,
h4,
h5,
h6 {
  margin: 0;
  color: var(--soms-text-900);
  font-weight: 600;
  letter-spacing: -0.015em;
}

p {
  margin: 0;
}

h1 {
  font-size: 26px;
  line-height: 1.25;
}

h2 {
  font-size: 21px;
  line-height: 1.3;
}

h3 {
  font-size: 18px;
  line-height: 1.35;
}

h4 {
  font-size: 15px;
  line-height: 1.4;
}

small {
  font-size: 12px;
}


/* =========================================================
   APPLICATION SHELL
   ========================================================= */

.soms-app {
  display: flex;
  width: 100%;
  min-height: 100vh;
  background: var(--soms-background);
}

.soms-main {
  flex: 1;
  min-width: 0;
  min-height: 100vh;
  background: var(--soms-background);
}

.soms-page {
  width: 100%;
  max-width: 1680px;
  margin: 0 auto;
  padding: 26px 30px;
}

.soms-page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.soms-page-title {
  color: var(--soms-text-900);
  font-size: 26px;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.02em;
}

.soms-page-description {
  max-width: 720px;
  margin-top: 5px;
  color: var(--soms-text-500);
  font-size: 13px;
  line-height: 1.55;
}


/* =========================================================
   CARDS
   ========================================================= */

.soms-card {
  overflow: hidden;
  background: var(--soms-surface);
  border: 1px solid var(--soms-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xs);

  transition:
    transform var(--transition),
    box-shadow var(--transition),
    border-color var(--transition);
}

.soms-card:hover {
  border-color: #d5dee7;
  box-shadow: var(--shadow-sm);
}

.soms-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;

  padding: 16px 18px;

  border-bottom: 1px solid var(--soms-border-light);
}

.soms-card-body {
  padding: 18px;
}

.soms-card-title {
  color: var(--soms-text-900);
  font-size: 15px;
  font-weight: 600;
}

.soms-card-subtitle {
  margin-top: 3px;
  color: var(--soms-text-500);
  font-size: 12px;
}


/* =========================================================
   DASHBOARD
   ========================================================= */

.soms-stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 20px;
}

.soms-stat-card {
  position: relative;
  min-width: 0;
  overflow: hidden;

  padding: 17px;

  background: var(--soms-surface);

  border: 1px solid var(--soms-border);
  border-radius: var(--radius-lg);

  box-shadow: var(--shadow-xs);

  transition:
    transform var(--transition),
    box-shadow var(--transition),
    border-color var(--transition);
}

.soms-stat-card:hover {
  transform: translateY(-2px);
  border-color: #cbdfe0;
  box-shadow: var(--shadow-md);
}

.soms-stat-label {
  color: var(--soms-text-500);
  font-size: 12px;
  font-weight: 500;
}

.soms-stat-value {
  margin-top: 6px;
  color: var(--soms-text-900);
  font-size: 26px;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.025em;
}

.soms-stat-meta {
  display: flex;
  align-items: center;
  gap: 5px;

  margin-top: 8px;

  color: var(--soms-text-500);
  font-size: 11px;
}

.soms-stat-icon {
  width: 36px;
  height: 36px;

  display: grid;
  place-items: center;

  flex-shrink: 0;

  border-radius: 9px;
}

.soms-stat-icon-blue {
  color: var(--soms-info-700);
  background: var(--soms-info-50);
}

.soms-stat-icon-green {
  color: var(--soms-success-700);
  background: var(--soms-success-50);
}

.soms-stat-icon-orange {
  color: var(--soms-warning-700);
  background: var(--soms-warning-50);
}

.soms-stat-icon-red {
  color: var(--soms-danger-700);
  background: var(--soms-danger-50);
}


/* =========================================================
   BUTTONS
   ========================================================= */

.soms-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  min-height: 40px;
  padding: 0 14px;

  border: 1px solid transparent;
  border-radius: var(--radius-md);

  font-size: 13px;
  font-weight: 600;

  white-space: nowrap;

  transition:
    transform var(--transition-fast),
    background var(--transition-fast),
    border-color var(--transition-fast),
    box-shadow var(--transition-fast),
    color var(--transition-fast);
}

.soms-button:hover {
  transform: translateY(-1px);
}

.soms-button:active {
  transform: translateY(0);
}

.soms-button-primary {
  color: #ffffff;
  background: var(--soms-teal-700);

  box-shadow:
    0 3px 8px rgba(13, 148, 136, 0.18);
}

.soms-button-primary:hover {
  background: var(--soms-teal-800);

  box-shadow:
    0 5px 12px rgba(13, 148, 136, 0.22);
}

.soms-button-secondary {
  color: var(--soms-text-700);
  background: var(--soms-surface);
  border-color: var(--soms-border);
}

.soms-button-secondary:hover {
  background: var(--soms-surface-hover);
}

.soms-button-success {
  color: #ffffff;
  background: var(--soms-success-600);
}

.soms-button-warning {
  color: #ffffff;
  background: var(--soms-warning-600);
}

.soms-button-danger {
  color: #ffffff;
  background: var(--soms-danger-600);
}

.soms-button-ghost {
  color: var(--soms-text-600);
  background: transparent;
}

.soms-button-ghost:hover {
  color: var(--soms-text-900);
  background: var(--soms-surface-hover);
}


/* =========================================================
   FORMS
   ========================================================= */

.soms-form-group {
  margin-bottom: 16px;
}

.soms-label {
  display: block;

  margin-bottom: 6px;

  color: var(--soms-text-700);

  font-size: 13px;
  font-weight: 500;
}

.soms-input,
.soms-select,
.soms-textarea {
  width: 100%;
  min-height: 42px;

  padding: 0 12px;

  color: var(--soms-text-900);
  background: #ffffff;

  border: 1px solid var(--soms-border-strong);
  border-radius: var(--radius-md);

  outline: none;

  font-size: 14px;

  transition:
    border-color var(--transition-fast),
    box-shadow var(--transition-fast);
}

.soms-input:hover,
.soms-select:hover,
.soms-textarea:hover {
  border-color: #94a3b8;
}

.soms-input:focus,
.soms-select:focus,
.soms-textarea:focus {
  border-color: var(--soms-teal-600);

  box-shadow:
    0 0 0 3px rgba(20, 184, 166, 0.10);
}

.soms-input::placeholder,
.soms-textarea::placeholder {
  color: var(--soms-text-400);
}

.soms-textarea {
  min-height: 100px;
  padding: 11px 12px;
  resize: vertical;
}


/* =========================================================
   TABLES
   ========================================================= */

.soms-table-wrapper {
  width: 100%;
  overflow-x: auto;
  scrollbar-width: thin;
}

.soms-table {
  width: 100%;
  min-width: 720px;

  border-collapse: separate;
  border-spacing: 0;
}

.soms-table th {
  padding: 11px 15px;

  color: var(--soms-text-500);
  background: var(--soms-surface-muted);

  border-bottom: 1px solid var(--soms-border);

  font-size: 11px;
  font-weight: 600;

  letter-spacing: 0.035em;

  text-align: left;
  text-transform: uppercase;
}

.soms-table td {
  padding: 13px 15px;

  color: var(--soms-text-600);
  background: #ffffff;

  border-bottom: 1px solid var(--soms-border-light);

  font-size: 13px;
}

.soms-table tbody tr {
  transition: background var(--transition-fast);
}

.soms-table tbody tr:hover td {
  background: #f8fbfb;
}

.soms-table tbody tr:last-child td {
  border-bottom: 0;
}


/* =========================================================
   STATUS BADGES
   ========================================================= */

.soms-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  padding: 5px 8px;

  border-radius: 999px;

  font-size: 11px;
  font-weight: 600;

  line-height: 1;

  white-space: nowrap;
}

.soms-badge-success {
  color: var(--soms-success-700);
  background: var(--soms-success-50);
}

.soms-badge-warning {
  color: var(--soms-warning-700);
  background: var(--soms-warning-50);
}

.soms-badge-danger {
  color: var(--soms-danger-700);
  background: var(--soms-danger-50);
}

.soms-badge-info {
  color: var(--soms-info-700);
  background: var(--soms-info-50);
}

.soms-badge-neutral {
  color: var(--soms-text-600);
  background: var(--soms-surface-hover);
}


/* =========================================================
   SEARCH
   ========================================================= */

.soms-search {
  position: relative;
  width: 100%;
}

.soms-search input {
  width: 100%;
  min-height: 40px;

  padding: 0 14px 0 40px;

  color: var(--soms-text-900);
  background: #ffffff;

  border: 1px solid var(--soms-border);
  border-radius: var(--radius-md);

  outline: none;

  transition:
    border-color var(--transition-fast),
    box-shadow var(--transition-fast);
}

.soms-search input:focus {
  border-color: var(--soms-teal-600);

  box-shadow:
    0 0 0 3px rgba(20, 184, 166, 0.10);
}


/* =========================================================
   DIVIDER
   ========================================================= */

.soms-divider {
  height: 1px;
  margin: 20px 0;
  background: var(--soms-border-light);
}


/* =========================================================
   EMPTY STATE
   ========================================================= */

.soms-empty {
  display: flex;

  min-height: 240px;

  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 30px;

  text-align: center;
}

.soms-empty-icon {
  width: 46px;
  height: 46px;

  display: grid;
  place-items: center;

  margin-bottom: 13px;

  color: var(--soms-text-400);
  background: var(--soms-surface-hover);

  border-radius: 11px;
}

.soms-empty-title {
  color: var(--soms-text-800);
  font-size: 15px;
  font-weight: 600;
}

.soms-empty-description {
  max-width: 380px;

  margin-top: 5px;

  color: var(--soms-text-500);

  font-size: 13px;
  line-height: 1.55;
}


/* =========================================================
   LOADING
   ========================================================= */

.soms-loading {
  display: flex;

  min-height: 280px;

  align-items: center;
  justify-content: center;
}

.soms-spinner {
  width: 27px;
  height: 27px;

  border: 3px solid var(--soms-teal-100);
  border-top-color: var(--soms-teal-700);

  border-radius: 50%;

  animation: soms-spin 700ms linear infinite;
}

.soms-spin-icon {
  animation: soms-spin 700ms linear infinite;
}

@keyframes soms-spin {
  to {
    transform: rotate(360deg);
  }
}


/* =========================================================
   PAGE TRANSITION
   ========================================================= */

.soms-page-enter {
  animation: soms-page-enter 240ms ease-out both;
}

@keyframes soms-page-enter {

  from {
    opacity: 0;
    transform: translateY(5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* =========================================================
   ALERTS
   ========================================================= */

.soms-alert {
  display: flex;
  align-items: flex-start;
  gap: 10px;

  padding: 12px 14px;

  border: 1px solid transparent;
  border-radius: var(--radius-md);

  font-size: 13px;
  line-height: 1.5;
}

.soms-alert-success {
  color: var(--soms-success-700);
  background: var(--soms-success-50);
  border-color: var(--soms-success-100);
}

.soms-alert-warning {
  color: var(--soms-warning-700);
  background: var(--soms-warning-50);
  border-color: var(--soms-warning-100);
}

.soms-alert-danger {
  color: var(--soms-danger-700);
  background: var(--soms-danger-50);
  border-color: var(--soms-danger-100);
}

.soms-alert-info {
  color: var(--soms-info-700);
  background: var(--soms-info-50);
  border-color: var(--soms-info-100);
}


/* =========================================================
   MODAL
   ========================================================= */

.soms-modal-backdrop {
  position: fixed;
  inset: 0;

  z-index: 100;

  display: grid;
  place-items: center;

  padding: 20px;

  background: rgba(7, 28, 38, 0.48);

  backdrop-filter: blur(4px);

  animation: soms-fade-in 160ms ease-out;
}

.soms-modal {
  width: min(100%, 560px);

  max-height: calc(100vh - 40px);

  overflow: auto;

  background: #ffffff;

  border: 1px solid var(--soms-border);
  border-radius: var(--radius-xl);

  box-shadow: var(--shadow-lg);

  animation: soms-modal-in 200ms ease-out;
}

@keyframes soms-fade-in {

  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes soms-modal-in {

  from {
    opacity: 0;
    transform: translateY(8px) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}


/* =========================================================
   AUTHENTICATION
   ========================================================= */

.soms-auth-page {
  min-height: 100vh;

  display: grid;
  place-items: center;

  padding: 24px;

  background:
    radial-gradient(
      circle at 15% 15%,
      rgba(45, 212, 191, 0.12),
      transparent 32%
    ),
    radial-gradient(
      circle at 85% 85%,
      rgba(20, 184, 166, 0.08),
      transparent 32%
    ),
    var(--soms-navy-950);
}

.soms-auth-container {
  width: min(100%, 430px);
}

.soms-auth-card {
  padding: 32px;

  background: #ffffff;

  border: 1px solid rgba(255, 255, 255, 0.35);

  border-radius: var(--radius-xl);

  box-shadow:
    0 24px 60px rgba(2, 6, 23, 0.28);
}

.soms-auth-brand {
  display: flex;
  align-items: center;
  gap: 11px;

  margin-bottom: 25px;
}

.soms-auth-brand-icon {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  flex-shrink: 0;

  color: #ffffff;

  background:
    linear-gradient(
      135deg,
      var(--soms-teal-700),
      var(--soms-teal-500)
    );

  border-radius: 10px;

  box-shadow:
    0 7px 17px rgba(13, 148, 136, 0.22);
}

.soms-auth-title {
  margin-bottom: 5px;

  color: var(--soms-text-900);

  font-size: 26px;
  font-weight: 600;

  line-height: 1.25;

  letter-spacing: -0.02em;
}

.soms-auth-subtitle {
  margin-bottom: 22px;

  color: var(--soms-text-500);

  font-size: 13px;
  line-height: 1.55;
}

.soms-auth-button {
  width: 100%;
  min-height: 44px;

  color: #ffffff;

  background:
    linear-gradient(
      135deg,
      var(--soms-teal-800),
      var(--soms-teal-600)
    );

  border: 0;
  border-radius: var(--radius-md);

  font-size: 14px;
  font-weight: 600;

  box-shadow:
    0 5px 14px rgba(13, 148, 136, 0.18);

  transition:
    transform var(--transition-fast),
    background var(--transition-fast),
    box-shadow var(--transition-fast);
}

.soms-auth-button:hover {
  background:
    linear-gradient(
      135deg,
      var(--soms-teal-900),
      var(--soms-teal-700)
    );

  transform: translateY(-1px);

  box-shadow:
    0 7px 18px rgba(13, 148, 136, 0.23);
}

.soms-auth-footer {
  margin-top: 18px;

  color: var(--soms-text-500);

  font-size: 12px;

  text-align: center;
}

.soms-auth-footer a {
  color: var(--soms-teal-700);
  font-weight: 600;
}


/* =========================================================
   GLOBAL BRAND OVERRIDES
   ---------------------------------------------------------
   These are intentional.

   They prevent common Tailwind utility classes from making
   individual parts of SOMS look like separate applications.
   ========================================================= */


/* Blue primary actions become SOMS teal */

.bg-blue-500,
.bg-blue-600,
.bg-blue-700 {
  background-color: var(--soms-teal-700) !important;
}

.hover\:bg-blue-600:hover,
.hover\:bg-blue-700:hover {
  background-color: var(--soms-teal-800) !important;
}

.text-blue-500,
.text-blue-600,
.text-blue-700 {
  color: var(--soms-teal-700) !important;
}

.border-blue-500,
.border-blue-600 {
  border-color: var(--soms-teal-600) !important;
}


/* Indigo should not create another SOMS theme */

.bg-indigo-500,
.bg-indigo-600,
.bg-indigo-700 {
  background-color: var(--soms-teal-700) !important;
}

.text-indigo-500,
.text-indigo-600,
.text-indigo-700 {
  color: var(--soms-teal-700) !important;
}


/* Purple should not create another SOMS theme */

.bg-purple-500,
.bg-purple-600,
.bg-purple-700 {
  background-color: var(--soms-teal-700) !important;
}

.text-purple-500,
.text-purple-600,
.text-purple-700 {
  color: var(--soms-teal-700) !important;
}


/* Emerald remains semantic rather than brand */

.text-emerald-500,
.text-emerald-600,
.text-emerald-700 {
  color: var(--soms-success-700) !important;
}


/* =========================================================
   COMMON TAILWIND SURFACE NORMALIZATION
   ========================================================= */

.bg-gray-50,
.bg-slate-50 {
  background-color: var(--soms-surface-muted) !important;
}

.bg-gray-100,
.bg-slate-100 {
  background-color: var(--soms-surface-hover) !important;
}

.text-gray-500,
.text-slate-500 {
  color: var(--soms-text-500) !important;
}

.text-gray-600,
.text-slate-600 {
  color: var(--soms-text-600) !important;
}

.text-gray-700,
.text-slate-700 {
  color: var(--soms-text-700) !important;
}

.text-gray-800,
.text-slate-800 {
  color: var(--soms-text-800) !important;
}

.text-gray-900,
.text-slate-900 {
  color: var(--soms-text-900) !important;
}


/* =========================================================
   COMMON BORDERS
   ========================================================= */

.border-gray-200,
.border-slate-200 {
  border-color: var(--soms-border) !important;
}

.border-gray-100,
.border-slate-100 {
  border-color: var(--soms-border-light) !important;
}


/* =========================================================
   FOCUS NORMALIZATION
   ========================================================= */

input:focus,
select:focus,
textarea:focus {
  outline: none;
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

* {
  scrollbar-width: thin;
  scrollbar-color: #cbd5e1 transparent;
}

::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1200px) {

  .soms-stat-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

}

@media (max-width: 900px) {

  .soms-page {
    padding: 23px 20px;
  }

  .soms-page-header {
    flex-direction: column;
    align-items: stretch;
  }

}

@media (max-width: 768px) {

  .soms-page {
    padding: 18px;
  }

  .soms-stat-grid {
    grid-template-columns: 1fr;
  }

  .soms-card-header,
  .soms-card-body {
    padding: 15px;
  }

  .soms-auth-card {
    padding: 27px 22px;
  }

}

@media (max-width: 480px) {

  .soms-page {
    padding: 14px;
  }

  .soms-auth-page {
    padding: 14px;
  }

  .soms-auth-card {
    padding: 24px 18px;
    border-radius: 14px;
  }

  .soms-button {
    width: 100%;
  }

}


/* =========================================================
   PRINT
   ========================================================= */

@media print {

  body {
    background: #ffffff !important;
  }

  .no-print {
    display: none !important;
  }

  .soms-card,
  .soms-stat-card {
    box-shadow: none !important;
  }

}